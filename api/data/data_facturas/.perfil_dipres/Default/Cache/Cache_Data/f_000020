function quote_literal(input){
        if (input != null && input != undefined && input != true && input != false && isNaN(input)){
                return input;
        }else if(input === undefined){
                return null;
        }else{
                return input;
        }
}
/* Reemplaza caracteres escapeados... por ejemplo &gt*/
function replace_html_escaped_characters(input){
        input=input.replace(new RegExp('&gt;', 'g'), '>');
        input=input.replace(new RegExp('&lt;', 'g'), '<');
        return input;
}
/*función para imprimir un objeto, para debug*/
function print_r(arr,level) {
        var dumped_text = "";
        if(!level) level = 0;

        /*The padding given at the beginning of the line.*/
        var level_padding = "";
        for(var j=0;j<level+1;j++) level_padding += "    ";

       if(typeof(arr) == 'object') {
          for(var item in arr) {
             var value = arr[item];

             if(typeof(value) == 'object') {
                dumped_text += level_padding + "'" + item + "' ...\n";
                dumped_text += print_r(value,level+1);
            } else {
                dumped_text += level_padding + "'" + item + "' => \"" + value + "\"\n";
            }
        }
    } else {
      dumped_text = "===>"+arr+"<===("+typeof(arr)+")";
  }
  return dumped_text;
};

