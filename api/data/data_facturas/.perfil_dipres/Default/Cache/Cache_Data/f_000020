        key = e.which;
    else
        return true;

    keychar = String.fromCharCode(key); // control key

        if ((key == null) || (key == 0) || (key == 8) || (key == 9) || (key == 13) || (key == 27))
            return true;
        //return (/^[a-z0-9 ]{1,}$/gi.test(keychar));
