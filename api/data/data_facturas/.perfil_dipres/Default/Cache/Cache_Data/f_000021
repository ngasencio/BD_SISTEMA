// Función para eliminar una fila de una tabla con nodejs - HBR 20170802
Tabla.prototype.nodeDeleteRow = function(id_name, id_value, ordenar){
        var id_div = this.id;

        if(ordenar == undefined)
                ordenar = 1;

        tabla_p = $("#" + id_div).find('table');

        tabla_p.find('[data-campo="'+id_name+'"][name="'+id_value+'"]').each(function(){
                the_tr = $(this).closest('tr');
                if(the_tr != undefined && the_tr.length > 0){
                        index = tabla_p.DataTable().row(the_tr).index();
                        tabla_p.DataTable().row(the_tr).remove().draw();

                        // reordenando la tabla
                        if (ordenar) {
                                var rowCount = tabla_p.DataTable().data().length,
                                tempRow,
                                tempNode;
                                for (var i=index;i<=rowCount; i++) {
                                        tempRow = tabla_p.DataTable().row(i);
                                        if (tempRow != undefined){
                                                tempNode = tempRow.node();
                                                var new_orden = +$(tempNode).find('td').first().attr('name') - 1;
                                                $(tempNode).find('td').first().attr('name', new_orden);
                                                $(tempNode).find('td').first().text(new_orden);
						tabla_p.DataTable().draw();
                                        }
                                }
                        }
                }
        });

        setTimeout(function(){
          tabla_p.DataTable().draw();
        }, 200);
}
