Tabla.prototype.deleteFileRowTX = function(objeto, params_json) {
    /*
    Función para borrar archivos que se suban con la tx subir_archivo_new. Por defecto llama a la tx borrar_archivo.
    */

    var id_div = this.id;
    var id_tabla = 'tabla_' + this.id;
    var tx1 = params_json['tx'];
    var params = params_json['labels_no_editable'];
    var flag_masivo = params_json['flag_masivo'];
    var id1 = params_json['id1'];
    var table = document.getElementById(id_tabla);
    var rowLength = table.rows[0].cells.length;

    if (tx1 == undefined || !tx1)
        tx1 = 'borrar_archivo_new';

    parametros = params;

    var send_parmas = {};

    if (flag_masivo.indexOf("form") >= 0) {
        add_to_form_obl_fields(flag_masivo, this.id);
        obj_tr = $("#" + objeto).closest('tr');
        for (var i = 0; i < parametros.length; i++) {
            $("input[type='hidden'][name='" + parametros[i] + "']").attr('value', obj_tr.find("td").eq(this.getIndex(parametros[i])).attr('name'));
        }
        send_parmas = $("#" + flag_masivo).serializeObject();
    } else {
        send_parmas = add_to_array_obl_fields(send_parmas, this.id);
        obj_tr = $("#" + objeto).closest('tr');
        for (var i = 0; i < parametros.length; i++) {
            send_parmas[parametros[i]] = obj_tr.find("td").eq(this.getIndex(parametros[i])).html();
        }
    }

    pass = true;

    if ($.inArray(params_json['valor'].toLowerCase(), ["eliminar", "delete", "erase", "borrar", "remove"]) != -1) {
        pass = confirm('\xbfDesea continuar? Esta acci\u00f3n eliminar\u00e1 el archivo y registro seleccionado.');
    }
    if ($.inArray(params_json['valor'].toLowerCase(), ["anular"]) != -1) {
        pass = confirm('\xbfDesea continuar? Esta acci\u00f3n anular\u00e1 el registro seleccionado.');
    }

    if (pass) {
        $.ajax({
            url: $("#uri").val() + "procesa_borrar_archivo.php",
            datatype: "json",
            type: "POST",
            data: {
                data: JSON.stringify(send_parmas),
                tx: tx1
            },
            success: function(responseText) {
                var respuesta = $.parseJSON(responseText);
                if (flag_masivo === "SI" || flag_masivo.indexOf("form") >= 0) {
                    var aux = analiza_respuesta(respuesta);
                } else {
                    var aux = analiza_respuesta(respuesta, 'SI');
                }

                //Si es exitosa la respuesta
                if (aux == '' || aux == 'OK') {
                    //Si es una accion masiva o esta asociada a un formulario
                    if (flag_masivo === "SI" || flag_masivo.indexOf("form") >= 0) {
                        if (typeof respuesta.RESPUESTA !== 'object' && (respuesta.RESPUESTA).indexOf("http") >= 0) {
                            $("#icono__" + id_div + "_" + objeto.replace('chk_', '')).html("<i title='" + respuesta.MENSAJE_RESPUESTA + "' style='font-size:18px;color:green;' class='glyphicon glyphicon-ok'></i>");
                            $("#icono__" + id_div + "_" + objeto.replace('chk_', '')).attr('href', respuesta.RESPUESTA);
                            $("#icono__" + id_div + "_" + objeto.replace('chk_', '')).attr('target', "_blank");
                        } else {
                            $("#icono__" + id_div + "_" + objeto.replace('chk_', '')).html("<i title='" + respuesta.MENSAJE_RESPUESTA + "' style='font-size:18px;color:green;' class='glyphicon glyphicon-ok'></i>");
                        }
                    }
                    //si no es una accion masiva recargamos la tabla - se asume q la tx cambio algo en la grilla
                    else {
                        if (respuesta.URL_RESPUESTA !== undefined && respuesta.URL_RESPUESTA !== "") {
                            window.location.href = respuesta.URL_RESPUESTA;
                        } else {
                            //alert(respuesta.MENSAJE_RESPUESTA);
                            eval(id_div).cargarTabla(1);
                        }
                    }
                }
                //Si NO es exitosa la respuesta
                else {
                    //Si es una accion masiva o esta asociada a un formulario
                    if (flag_masivo === "SI" || flag_masivo.indexOf("form") >= 0) {
                        $("#icono__" + id_div + "_" + objeto.replace('chk_', '')).html("<i title='" + respuesta.MENSAJE_RESPUESTA + "' class='glyphicon glyphicon-remove' style='font-size:18px;color:red;' ></i>");
                    } else {
                        //alert(respuesta.MENSAJE_RESPUESTA);
                        if (respuesta.URL_RESPUESTA !== undefined && respuesta.URL_RESPUESTA !== "") {
                            window.location.href = respuesta.URL_RESPUESTA;
                        }
                    }
                }

                //Chequeamos si tenemos mas registros que enviar y escondemos el modal de ser necesario
                if (flag_masivo === "SI") {
                    if (params_json['i'] < params_json['total'] - 1) {
                        params_json['i'] = parseInt(params_json['i']) + 1;
                        eval(id_div + ".rowMasivo('" + flag_masivo + "'," + JSON.stringify(params_json) + ");");
                        //id_div.rowMasivo(flag_masivo, params_json);
                    } else {
                        $("#myModal").modal('hide');
                    }
                }

                if (flag_masivo.indexOf("form") >= 0) {
                    if (params_json['i'] < params_json['total'] - 1) {
                        if (respuesta.CODIGO_RESPUESTA !== "1") {
                            //Se marca que alguno(s) de los registros fallo
                            $("#resp_modal").val('NO_OK');
                        }
                        params_json['i'] = parseInt(params_json['i']) + 1;
                        eval(id_div + ".formMasivo(" + JSON.stringify(params_json) + ");");
                        //id_div.formMasivo(params_json);
                        $("#shader").fadeOut();
                    } else {
                        if (respuesta.CODIGO_RESPUESTA !== "1") {
                            //Se marca que alguno(s) de los registros fallo
                            $("#resp_modal").val('NO_OK');
                        }
                        $("#myModal").modal('hide');
                        $("#shader").fadeOut();
                    }
                }
            }
        });
    }

}

Tabla.prototype.formMasivoDirecto = function(params) {
    if (!checkRequired(params['form']))
        return;
    var i = params['i'];
    if (i == 0) {
        if ($("input[class='chkClass_" + this.id + "']:checked").length == 0) {
            alert("Debe seleccionar elementos, por favor.");
            return false;
        }
    }
    var id_tabla = 'tabla_' + this.id;
    var campos = params['labels_no_editable'];
    var form = params['id_form'];
    var table = document.getElementById(id_tabla);
    var rowLength = table.rows[0].cells.length;
    var objeto=this.id;
    var tx1=params["tx"];
    var send_parmas = {};
    var lista = [];
    var json1 = {};
    var j=0;

    $("input[class='chkClass_" + this.id + "']:checked").each(function(){
        send_parmas = add_to_array_obl_fields(send_parmas, this.id);
        obj_tr = $(this).closest('tr');
        obj_table = $(this).closest('table');
        for (var i = 0; i < campos.length; i++) {
            var index1=eval(objeto + ".getIndex('"+campos[i]+"')");
            json1[campos[i]] = obj_tr.find("td").eq(eval(objeto + ".getIndex('"+campos[i]+"')")).html();
            json1["ID_CHK"]='chkClass_' + this.id;
        }
        lista[j]=json1;
        j=j+1;
    });
    if (form.indexOf("form") >= 0) {
        $("#" + form).each(function(){
            send_parmas[$(this).attr('name')] = $(this).val();
        });
    }
    send_parmas["lista"]=lista;
    $.ajax({
            url: $("#uri").val() + "procesa.php",
            datatype: "json",
            type: "POST",
            data: {
                data: JSON.stringify(send_parmas),
                tx: tx1
            },
            success: function(responseText) {
                var respuesta = $.parseJSON(responseText);
                var aux = analiza_respuesta(respuesta,'SI');
                if(aux=='OK'){
                    $("input[class='chkClass_" + this.id + "']:checked").each(function(){
                        var msg=eval(respuesta + "." + 'msg_chkClass_' + this.id);
                        if(msg===undefined || msg===''){
                            msg=respuesta.MENSAJE_RESPUESTA;
                        }
                        $("#icono__" + objeto + "_" + $(this).replace('chk_', '')).html("<i title='" + msg + "' style='font-size:18px;color:green;' class='glyphicon glyphicon-ok'></i>");
                    });
                }else{
                    $("input[class='chkClass_" + this.id + "']:checked").each(function(){
                        $("#icono__" + id_div + "_" + objeto.replace('chk_', '')).html("<i title='" + respuesta.MENSAJE_RESPUESTA + "' class='glyphicon glyphicon-remove' style='font-size:18px;color:red;' ></i>");
                    });
                }
            }
        });
}
