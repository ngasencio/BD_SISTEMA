//Clase Tabla
var Tabla = function(params) {
    this.id = params['id_div'];
    this.tipo = params['tipo'];
    this.obj_related = params['obj_related'];
    this.tipo_obj_related = params['tipo_obj_related'];
    this.node_activo = 0;//20191016 HB
};

//Inicilizador Tabla
Tabla.prototype.InitLoad = function() {
    $("#todosChk_" + this.id).click(function(evento) {
        if (this.checked) { // check select status
            $('.chkClass_' + this.id).each(function() { //loop through each checkbox
                this.checked = true; //select all checkboxes with class "checkbox1"
            });
        } else {
            $('.chkClass_' + this.id).each(function() { //loop through each checkbox
                this.checked = false; //deselect all checkboxes with class "checkbox1"
            });
        }

    });
/*    if ($("#div_body_" + this.id).length) {
        $('#tabla_' + this.id).footable();
        $("td, th").attr("style", "white-space: nowrap; display: table-cell");
        $('#div_body_' + this.id).removeAttr("hidden");
    } else {
        $('#div_body_' + this.id).removeAttr("hidden");
    }*/
    $("#btnSiguiente_" + this.id).click(function() {
        if ($.isNumeric($("#offset_" + this.id).val())) {
            var currentPage = parseInt($("#offset_" + this.id).val());
            var nextPage = currentPage + 1;
            this.irPagina(nextPage);
        } else {
            alert("pagina no numerica");
        }
    });
    $("#btnAnterior_" + this.id).click(function() {
        if ($.isNumeric($("#offset_" + this.id).val())) {
            var currentPage = parseInt($("#offset_" + this.id).val());
            var prevPage = currentPage - 1;
            this.irPagina(prevPage);
        } else {
            alert("pagina no numerica");
        }
    });
};

//Cargar posicion de las columnas de la grilla
Tabla.prototype.LoadIndexes = function() {
    if ($("#tabla_" + this.id).length) {
        var table = document.getElementById('tabla_' + this.id);
        var rowLength = table.rows[0].cells.length;
        var indexes = new Object();
        var aux = '';
        for (var i = 0; i < rowLength; i += 1) {
            aux = (table.rows[0].cells[i].getAttribute("name")).replace(' ', '_');
            indexes[aux] = i;
        }
        $("#indexes_" + this.id).attr('value', JSON.stringify(indexes));
    }
};

Tabla.prototype.getIndex = function(prop) {
    return $.parseJSON($("#indexes_" + this.id).val())[prop];
};

//Funcion que carga la grilla
