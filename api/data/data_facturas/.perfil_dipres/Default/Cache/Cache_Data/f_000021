                                    $('#' + id_div + ' form').find('input[name="' + nombre + '_b64' + '"]').remove();
                                    $('<input>').attr({
                                        type: 'hidden',
                                        name: nombre + '_b64',
                                        value: base64
                                    }).appendTo('#' + id_div + ' form');
                                    procesar_file = 1;
                                });
                            }
                            if ($this.val() == '') {
                                if ($this.closest('div').hasClass('required')) {
                                    alert("Debe seleccionar el(los) archivos");
                                    $("#" + id_div).find('#spinnercirclegif').remove();
