        var $this = $(this);

        var fileName = $this.val().match(/[^\/\\]+$/);

        if (fileName != '' && fileName != undefined && fileName[0] != undefined && fileName != null && fileName != 'null') {
            var fileExtension = fileName[0].slice((fileName[0].lastIndexOf(".") - 1 >>> 0) + 2).toLowerCase();
            if ($this.attr('data-extensions') != '') {
                array_ext = $this.attr('data-extensions').replace(' ', '').split(',');
                if ($.inArray(fileExtension, array_ext) == -1) {
                    tipo_archivo_ok = false;
                }
