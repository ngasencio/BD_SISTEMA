                                $('#' + id_div + ' form').find('input[name="' + nombre + '"]').remove();
                                $('<input>').attr({
                                    type: 'hidden',
                                    name: nombre,
                                    value: fileName
                                }).appendTo('#' + id_div + ' form');
                                //$this.remove();
                                $this.val('');
                            }
                        });
                        var procesa_interval = setInterval(function() {
                            if (procesar_file || timeout == 20) {
                                clearInterval(procesa_interval);
                                $.ajax({
                                    url: $("#uri").val() + "procesa_file.php?app_dinamica=" + $("#app_dinamica").val() + "&session_id=" + $("#session_id").val() + "&rutCliente=" + $("#rutCliente").val() + "&tx=" + tx1,
