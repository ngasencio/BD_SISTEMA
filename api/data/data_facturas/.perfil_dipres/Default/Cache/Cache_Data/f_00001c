Form.prototype.exportarSql = function(el, tabla) {
        var id_div=this.id;

                tx1 = 'exportar_tabla_sql';

                // alert($(el).val());
                if($(el).val() != ''){
                        $(el).attr('disabled', 'disabled');
                }

                if (!checkRequired(id_div)){
                                $(el).removeAttr('disabled');
                return;
                }

        var obj_related = $("#" + this.id).attr("obj_related");
        //add_to_form_obl_fields("form_params", this.id);

        var valores = {};
                //to hex
                $("#"+id_div).find('input').each(function(){
                        if($(this).attr('data-hex') == 'true'){
                                valores[$(this).attr('name')] = $(this).val();
                                $(this).val(stringToHex($(this).val()));
                        }
                });
                //var serialized = $("#+id_div").serialize_options();
                var form_serial=serializeDivs('[{"obj_related":"' + this.id + '","tipo":"form"}]',this.id);

                //to val
                condicion = '';
                $("#"+id_div).find('input, select').each(function(){
                        //generando la condición con los inputs, enviándola en hexa y agregándosela al form_serial después
                        if($(this).attr('type') != 'button' && $(this).attr('name') != 'uri_params' && $(this).attr('name') != 'current_url' && $(this).attr('name') != 'uri_comun'){
                                condicion = (condicion == '')? $(this).attr('name')+" = '"+$(this).val()+"'" : condicion+' and '+$(this).attr('name')+" = '"+$(this).val()+"'";
                        }

                        //hex to val (volviendo los input_hex a texto en pantalla)
                        if($(this).attr('data-hex') == 'true'){
                                $(this).val(valores[$(this).attr('name')]);
                        }
                });

                form_serial+='&tabla='+tabla+'&condicion='+stringToHex(condicion);

                $.ajax({
                                url: $("#uri").val() + "procesa_form.php?tx=" + tx1,
                                datatype: "json",
                                type: "POST",
                                //data: serialized,
                                data: form_serial,
                                success: function(responseText) {
                                                $(el).removeAttr('disabled');
                                                var respuesta = $.parseJSON(responseText);

                                                if(respuesta.CODIGO_RESPUESTA == 1){
                                                        $("#"+id_div).find('form')[0].reset();

                                                        var file_data = '';
                                                        var filename = 'dump_pantalla_dinamica_'+respuesta.RESPUESTA.tabla+'.sql';
                                                        var datos = respuesta.RESPUESTA.file_datos.replace(/\\\"\\\"/g,"&quot;").replace(/\\\"/g,"").replace(/{\"/g,"").replace(/\"}/g,"").split('","');

                                                        for(var r in datos){
                                                                file_data += datos[r].replace(/&quot;/g, "\"")+'\n';
                                                        }

                                                        var blob = new Blob([file_data], {
                                                                type: 'text/plain;charset=utf-8;'
                                                        });
                                                        if (navigator.msSaveBlob) { // IE 10+
                                                                        navigator.msSaveBlob(blob, filename);
                                                        } else {
                                                                        var link = document.createElement("a");
                                                                        if (link.download !== undefined) { // feature detection
                                                                                        var url = URL.createObjectURL(blob);
                                                                                        link.setAttribute("href", url);
                                                                                        link.setAttribute("download", filename);
                                                                                        link.style.visibility = 'hidden';
                                                                                        document.body.appendChild(link);
                                                                                        link.click();
                                                                                        document.body.removeChild(link);
                                                                        }
                                                        }
                                                }else{
                                                        alert(respuesta.MENSAJE_RESPUESTA);
                                                }
                                }
                });
}

