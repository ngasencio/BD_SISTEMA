/* Vuelve a Cargar Todos los DIVs Relacionados segun su tipo */
function reload_div(id_div, tipo_div,el) {
    el=el||undefined;
    if(id_div==='')
            return;
    var json_divs=$.parseJSON(id_div);
    var json_divs_length=json_divs.length;
    for(var i=0; i<json_divs_length;i++){
            var aux_div=json_divs[i]['obj_related'];
            var aux_tipo=json_divs[i]['tipo'];
            if (aux_tipo === "tabla" || aux_tipo === "table") {
                                    if ($('#'+aux_div).length != 0){
                                            eval(aux_div).cargarTabla(null,null,el);
                                    }
            } else if (aux_tipo === "form") {
                            if(json_divs[i]['flag_in_div']==='DIV'){
                                            if ($('#'+aux_div).length != 0){
                                                    eval(aux_div).cargarForm();
                                            }
                            }else{
                                    aux_div=new Form({"id_div":aux_div,"tipo":"form"});
                                    // eval(aux_div).cargarForm();
                                    aux_div.cargarForm();
                            }
            } else if (aux_tipo === "acordeon") {
                            if ($('#'+aux_div).length != 0){
                    eval(aux_div).cargarAcordeon();
                            }
            } else if (aux_tipo === "grafico") {
                            if ($('#'+aux_div).length != 0){
                    eval(aux_div).cargarGrafico();
                            }
            } else if (aux_tipo === "mapa") {
                            if ($('#'+aux_div).length != 0){
                    eval(aux_div).cargarMapa();
                            }
            } else if (aux_tipo === "visualizador") {
                            if ($('#'+aux_div).length != 0){
                    eval(aux_div).cargarVisualizador();
                            }
            } else if (aux_tipo === "tabs") {
                            if ($('#'+aux_div).length != 0){
                    eval(aux_div).cargarTabs();
                            }
            } else if (aux_tipo === "pantalla_recursiva") {
                            if ($('#'+aux_div).length != 0){
                    eval(aux_div).cargarPantallaRecursiva();
                            }
            }else if (aux_tipo === "matriz_cuad") {
                            if ($('#'+aux_div).length != 0){
                eval(aux_div).cargarMatrizCuad();
                            }
            }else if (aux_tipo === "div_padre") {
                    if ($('#'+aux_div).length != 0){
                            eval(aux_div).cargarDivPadre();
                    }
            }else if (aux_tipo === "steps") {
                    if ($('#'+aux_div).length != 0){
                            eval(aux_div).cargarSteps();
                    }
            }

    }
}

