function change_required(obj,action)
{
    if (action=='show')
    {
            if ($(obj).hasClass('ori_required'))
            {
                    $(obj).addClass('required');
                    $(obj).removeClass('ori_required');
            }
    }
    else
    {
            if ($(obj).hasClass('required'))
            {
                    $(obj).addClass('ori_required');
                    $(obj).removeClass('required');
            }
    }
}


function reload_div_related(id_divs){
    if (id_divs=='' || id_divs===undefined){return false;   }
    arr_id_divs=id_divs.split(' ');
    $.each(arr_id_divs,(i1,v1)=>{
            tipo=$('#'+v1).attr("tipo");
            reload_div('[{"obj_related":"'+v1+'","tipo":"'+tipo+'"}]',null)
    });
}