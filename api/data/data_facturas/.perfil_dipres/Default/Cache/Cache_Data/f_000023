/*----------------------------FUNCIONES de Serializacion------------------------*/
$.fn.serializeObject = function() {
    var o = {};
    var a = this.serializeArray();
    $.each(a, function() {
            if (o[this.name]) {
                    if (!o[this.name].push) {
                            o[this.name] = [o[this.name]];
                    }
                    o[this.name].push(this.value || '');
            } else {
                    o[this.name] = this.value || '';
            }
    });
    return o;
};

$.fn.serialize_options = function() {
            var disabled = this.find(':disabled').removeAttr('disabled');
    var output = this.serialize();
            disabled.attr('disabled','disabled');
    $(".conected_dropdowns").each(function() {
            var options = $(this).find('option');
            var sel_name = $(this).attr("name");
            var map = $.map(options, function(element) {
                    var $element = $(element);
                    return $element.val();
            });
            var map2 = map.join('&');
            if (map !== "")
                    output = output + "&" + sel_name + "=" + map;
    });

            //checkbox en off
            this.find('input:checkbox:not(:checked)').each(function(){
                    output = output + '&' + $(this).attr('name') + '=off';
            });
            this.find('input:radio:checked').each(function(){
                    output = output + '&' + $(this).attr('name') + '='+$(this).attr('value');
            });

    return output;
};

