function checkRequired(form, msg) {
    var ans = true;
            var focus = false;

            if (msg === undefined || msg === ''){
                    msg = true;
            }

            $('#' + form).find('.required').each(function() {
                            var div_padre = $(this).closest('div.form-group');
                            div_padre.removeClass('has-error');
                            if ($(this).attr('name') != undefined && !$(this).val()) {
                                    div_padre.addClass('has-error');
                                    if(!focus){
                                            $(this).focus();
                                            focus = true;
                                    }
                                    ans = false;
                            }

                            /* agregado lo del note-editor y summernote para validad los textarea wysiwyg*/
                            if($(this).attr('name') != undefined && $(this).siblings('.note-editor').length > 0){
                                    $(this).siblings('.note-editor').css('border','1px solid #a9a9a9');
                                    if($(this).summernote('isEmpty')){
                                            $(this).siblings('.note-editor').css('border','1px solid #a94442');
                                            if(!focus){
                                                    $(this).focus();
                                                    focus = true;
                                            }
                                            ans = false;
                                    }
                            }
                            // agregando para el select2 (caso dropdown multiple) - HBR 20180424
                            if ($(this).siblings('.select2').length > 0){
                                    $(this).siblings('.select2').find('.select2-selection').css('border', '1px solid #aaa');
                                    if(!$(this).val()){
                                            $(this).siblings('.select2').find('.select2-selection').css('border', '1px solid #a94442');
                                    }
                            }

            });

            if(!ans && msg) alert('Debe completar los campos obligatorios');
    return ans;
}

