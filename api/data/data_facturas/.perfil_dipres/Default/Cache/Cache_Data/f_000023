/*-------------------FUNCIONES para el tipo de Input CONNECTED_DROPDOWNS--------------*/
function orderSelect(id) {
    var sel = $(id);
    var opts_list = sel.find('option');
    opts_list.sort(function(a, b) {
            return ($(a).val().indexOf("*") < 0 && $(a).val().indexOf("-") < 0 && $(a).val() > $(b).val()) ? 1 : -1;
    });
    sel.html('').append(opts_list);
    return;
    var options = $(id);
    options.detach().sort(function(a, b) {
            var at = $(a).text();
            var bt = $(b).text();
            return (at > bt) ? 1 : ((at < bt) ? -1 : 0);
    });
    options.appendTo(id);
}
function orderSelect_attr(id,attr1) {
    var sel = $(id);
    var opts_list = sel.find('option');
    opts_list.sort(function(a, b) {
            return (+parseInt($(a).attr(attr1)) > +parseInt($(b).attr(attr1))) ? 1 : -1;
    });
    sel.html('').append(opts_list);
    return;
}

