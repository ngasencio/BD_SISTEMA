function parseValuesForm(form){
                    $.each(form, function(key) {

                            valor = eval("form."+key);
                            if(typeof(eval("form."+key)) == 'object'){
                                    valor = JSON.stringify(valor);
                            }
                            //console.log('VALOR='+valor+' KEY='+key);

                            //checkbox
                            if($("input[name='"+key+"'][lista_input='SI']").length>0){
                                    try{
                                            panel_body = $("input[name='"+key+"']").closest(".input-list-container").find(".panel-body");
                                            panel_body.parent().slideUp("fast");
                                            panel_body.html('');
                                    }catch(err) {
                                            console.log('falla panel_body parseValuesForm');
                                    }
                                    var res = valor.split(",");
                                    for(var i=0;i<res.length;i++){
                                            $("input[name='"+key+"'][lista_input='SI']").val(res[i]);
                                            $("input[name='"+key+"_agregar']").click();
                                    }
                            }
                            else if($("input[name='"+key+"'][group_list='SI']").length>0){
                                    addGroupFormTable($("input[name='"+key+"']").closest('div').parent().parent().attr('id'),valor);
                            }
                            else if($("input[name='"+key+"']").attr('type') == 'checkbox'){
                                    var checked = (valor != '' && valor != 'false')? 'checked' : '';
                                    $("input[name='"+key+"']").prop('checked', checked);
                            }
                            else if($("input[name='"+key+"']").attr('type') == 'radio'){
                                    $('[name="'+key+'"][value="'+valor+'"]').attr('checked', 'true');
                            }
                            else{
                                    $("input[name='"+key+"'], select[name='"+key+"'], textarea[name='"+key+"']").val(valor);
                            }
                            //wysiwyg
                            if($("textarea[name='"+key+"']").siblings('.note-editor').length > 0){
                                    that = $(this);
                                    $("textarea[name='"+key+"']").summernote("code", valor);
                            }

                            //dropdown multiple
                            if($("select#"+key).length > 0 && $("select#"+key).hasClass('select2-hidden-accessible')){
                                    //valor debe ser un tsvector
                                    var valor_array = new Array();
                                    if(valor){
                                            res = valor.split(' ');
                                            $.each(res, function (i,v)
                                            {
                                                    valor_array.push(v.replace(/'/g,''));
                                            });
                                    }
                                    $("select#"+key).select2("val", valor_array);
                            }

                            var obj = $("[name='"+key+"']");
                            if(obj.is("span") || obj.is("h1") || obj.is("h2") || obj.is("h3") || obj.is("h4") || obj.is("h5") || obj.is("h6")){
                                    obj.html(valor);
                            }else if(obj.is("a")){
                                    obj.attr("href", valor);
                            }

                            /* inputs con ID */
                            if($("input#"+key).length > 0){
                                    $("input#"+key).val(valor);
                            }

                            /* on change del elemento (input)*/
                            // NBV 20180810 - Se comentan para que no se pierdan los valores al recargar divs
                            /*if($("input[name='"+key+"']").attr('onchange')!==''){
                                    $("input[name='"+key+"']").change();
                            }else{
                                    $("input[name='"+key+"']").change();
                            }
                            if($("select[name='"+key+"']").attr('onchange')!==''){
                                    $("select[name='"+key+"']").change();
                            }*/

                    });
            // NBV-20180810
            $.each(form, function(key) {
                    / *on change del elemento (input)*/
                    if($("input[name='"+key+"']").attr('onchange')!==''){
                        $("input[name='"+key+"']").change();
                    }else{
                        $("input[name='"+key+"']").change();
                    }
                    if($("select[name='"+key+"']").attr('onchange')!==''){
                        $("select[name='"+key+"']").change();
                    }
            });
}

